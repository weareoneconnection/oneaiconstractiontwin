# OneAI Construction Twin v0.7.0 - enterprise deployment template
# Store real values in Vault, Kubernetes Secrets, or the cloud secret manager.
APP_ENV=production
APP_NAME=OneAI Construction Twin
PUBLIC_BASE_URL=https://api.twin.example.com
WEB_BASE_URL=https://twin.example.com
NEXT_PUBLIC_API_URL=https://api.twin.example.com
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@postgres.example:5432/construction_twin
AUTO_MIGRATE=false
REQUIRE_MIGRATION_HEAD=true
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
REDIS_URL=rediss://REPLACE_REDIS
REDIS_REQUIRED=true

CORS_ORIGINS=https://twin.example.com
TRUSTED_HOSTS=twin.example.com,api.twin.example.com,construction-twin-api
FORCE_HTTPS=true
SECURITY_HEADERS_ENABLED=true
MAX_UPLOAD_MB=2048

AUTH_MODE=oidc
ALLOW_DEV_HEADER_AUTH=false
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=oneai-construction-twin
JWT_AUDIENCE=construction-twin-api
OIDC_ISSUER=https://login.example.com/realms/oneai
OIDC_AUDIENCE=construction-twin-api
OIDC_JWKS_URL=https://login.example.com/realms/oneai/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256
API_KEY_RECORDS_JSON={}

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=false

ASSET_STORAGE_BACKEND=s3
ASSET_OBJECT_PREFIX=v07
ASSET_WORK_ROOT=/data/asset-work
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_BUCKET=construction-twin
S3_REGION=ap-southeast-1

REQUIRE_ASSET_WORKER=true
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=90
PROVIDER_HEALTH_REQUIRED=false

ONEAI_CORE_URL=
ONEAI_CORE_API_KEY=
ONEFIELD_URL=
ONEFORGE_URL=
ONECLAW_URL=

OTEL_ENABLED=true
OTEL_SERVICE_NAME=oneai-construction-twin-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
SENTRY_DSN=

BACKUP_ROOT=/backups
BACKUP_RETENTION_DAYS=30
DEMO_ENDPOINTS_ENABLED=false
PILOT_NAME=Steel Structure Schedule Intelligence
