# ---------------------------------------------------------------------------
# Railway environment reference for OneAI Construction Twin v0.7.1
#
# Set these on the `api` and `asset-worker` services. Values written as
# ${{Service.VAR}} are Railway reference variables: paste them literally, Railway
# resolves them at deploy time.
#
# The three NEXT_PUBLIC_* values belong to the `web` service only, and must be set
# as BUILD arguments as well as variables - Next inlines them at build time.
# ---------------------------------------------------------------------------

# --- Build selection -------------------------------------------------------
# The api and asset-worker services need nothing here: Railway auto-detects the
# root Dockerfile, which is the API image.
# The web service must override it:
#   RAILWAY_DOCKERFILE_PATH=apps/web/Dockerfile

# --- Runtime mode ----------------------------------------------------------
# Use `staging` until an identity provider is connected. `production` refuses to
# start unless OIDC/JWT, HTTPS, non-wildcard CORS and disabled demo endpoints are
# all configured - see docs/DEPLOY_RAILWAY.md.
APP_ENV=staging
LOG_LEVEL=INFO

# --- Data ------------------------------------------------------------------
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_REQUIRED=true

# Migrations: only the api service may run them, or two services race on startup.
AUTO_MIGRATE=true          # asset-worker: false
REQUIRE_MIGRATION_HEAD=true

# --- Object storage --------------------------------------------------------
# Railway containers have an ephemeral filesystem. Generated tiles MUST go to an
# S3-compatible store (Cloudflare R2, Backblaze B2, AWS S3) or they vanish on redeploy.
ASSET_STORAGE_BACKEND=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=construction-twin
S3_REGION=auto
S3_ACCESS_KEY=<r2-access-key>
S3_SECRET_KEY=<r2-secret-key>

# --- HTTP / proxy ----------------------------------------------------------
FORCE_HTTPS=true
# Railway terminates TLS at its edge proxy, so forwarded headers are trustworthy here.
TRUST_FORWARDED_FOR=true
TRUSTED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=https://<your-web-domain>
PUBLIC_BASE_URL=https://<your-api-domain>
WEB_BASE_URL=https://<your-web-domain>

# --- Authentication --------------------------------------------------------
AUTH_MODE=hybrid
ALLOW_DEV_HEADER_AUTH=true          # must be false in production
JWT_SECRET=<openssl rand -base64 48>
JWT_ISSUER=oneai-construction-twin
JWT_AUDIENCE=construction-twin-api
# Fill these in when the identity provider is connected, then set APP_ENV=production
# and ALLOW_DEV_HEADER_AUTH=false.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Public client id used by the browser sign-in (Authorization Code + PKCE).
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile email
# Claim names carrying the tenant scope; defaults suit a provider with mappers set up.
OIDC_TENANT_CLAIM=tenant_id
OIDC_ORGANIZATION_CLAIM=organization_id
# Single-tenant deployments can skip the mappers and fix the scope here instead.
OIDC_DEFAULT_TENANT=
OIDC_DEFAULT_ORGANIZATION=

# --- Operations ------------------------------------------------------------
DEMO_ENDPOINTS_ENABLED=true         # must be false in production
REQUIRE_ASSET_WORKER=true
WORKER_STALE_AFTER_SECONDS=90
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_MB=512

# --- Web service (build args + variables) ----------------------------------
# NEXT_PUBLIC_API_URL=https://<your-api-domain>
# NEXT_PUBLIC_TENANT_ID=demo-tenant
# NEXT_PUBLIC_ORGANIZATION_ID=demo-org
# NEXT_PUBLIC_USER_ID=demo-user
# NEXT_PUBLIC_ROLE=platform_admin
