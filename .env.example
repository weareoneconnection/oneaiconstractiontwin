# OneAI Construction Twin v0.7.0 Enterprise Pilot Edition
# Local development configuration. Never reuse development secrets in production.
APP_ENV=development
APP_NAME=OneAI Construction Twin
PUBLIC_BASE_URL=http://127.0.0.1:8000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# Database and migrations
DATABASE_URL=sqlite:///./construction_twin.db
AUTO_MIGRATE=true
REQUIRE_MIGRATION_HEAD=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis is optional for a single-process local run and required for distributed workers.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# Browser and transport security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
FORCE_HTTPS=false
SECURITY_HEADERS_ENABLED=true
MAX_UPLOAD_MB=512
ALLOWED_UPLOAD_EXTENSIONS=.ifc,.glb,.gltf,.json,.csv,.pdf,.docx,.xlsx,.jpg,.jpeg,.png

# Authentication. headers mode is local-development compatibility only.
AUTH_MODE=hybrid
ALLOW_DEV_HEADER_AUTH=true
JWT_SECRET=development-only-change-me-please-rotate-now-32-chars!!
JWT_ALGORITHM=HS256
JWT_ISSUER=oneai-construction-twin
JWT_AUDIENCE=construction-twin-api
JWT_EXP_MINUTES=60
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
API_KEY_RECORDS_JSON={}

# Request protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true

# Runtime data roots
UPLOAD_ROOT=../../data/uploads
GENERATED_ASSET_ROOT=../../data/generated-assets

# Distributed asset pipeline
ASSET_STORAGE_BACKEND=local
ASSET_LOCAL_ROOT=../../data/object-store
ASSET_OBJECT_PREFIX=v07
ASSET_WORK_ROOT=../../data/asset-work
ASSET_WORKER_POLL_SECONDS=1.0
ASSET_WORKER_LEASE_SECONDS=180
ASSET_JOB_MAX_ATTEMPTS=3
ASSET_PARTITION_MAX_ENTITIES=64
ASSET_PARTITION_MAX_TRIANGLES=1000000
ASSET_MAX_TRIANGLES_PER_ENTITY=120000
ASSET_COMPRESSION=none
GLTF_TRANSFORM_BIN=gltf-transform

# S3 / MinIO when ASSET_STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=oneai
S3_SECRET_KEY=oneai-secret
S3_BUCKET=construction-twin
S3_REGION=us-east-1

# Readiness policy
REQUIRE_ASSET_WORKER=false
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=90
PROVIDER_HEALTH_REQUIRED=false

# OneAI integration boundaries
# OneAI Core is an OpenAI-compatible gateway: POST {url}/v1/chat/completions with
# `Authorization: Bearer <key>`. The model string is routed by the gateway, so switching
# provider is configuration, not code. Leave the URL empty to run the local
# deterministic reasoner instead (every answer is then labelled model_backed: false).
ONEAI_CORE_MODEL=openai:gpt-4o-mini
ONEAI_CORE_MAX_TOKENS=700
ONEAI_CORE_TEMPERATURE=0.2
ONEAI_CORE_URL=
ONEAI_CORE_API_KEY=
ONEFIELD_URL=
ONEFORGE_URL=
ONECLAW_URL=

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=oneai-construction-twin-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Backup / recovery
BACKUP_ROOT=../../data/backups
BACKUP_RETENTION_DAYS=14

# Pilot controls
DEMO_ENDPOINTS_ENABLED=true
PILOT_NAME=Steel Structure Schedule Intelligence
